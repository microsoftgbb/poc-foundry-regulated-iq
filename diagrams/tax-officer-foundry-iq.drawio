calAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="1843.8" width="924.0" height="47.5" as="geometry" /></mxCell><mxCell id="project-gates-body-4" value="Prove cross-officer denial, citation access, private runtime and metadata-only logging." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="1870.4" width="1069.92" height="47.5" as="geometry" /></mxCell><mxCell id="project-gates-body-5" value="Validate the two-officer pattern before eventual expansion to ten officers." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="1897.0" width="924.0" height="47.5" as="geometry" /></mxCell><mxCell id="optional-apim" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;fillColor=none;strokeColor=#605E5C;dashed=1;" parent="1" vertex="1"><mxGeometry x="30" y="1965" width="1240" height="125" as="geometry" /></mxCell><mxCell id="optional-apim-title-0" value="&lt;b&gt;OPTIONAL APIM • only for a genuinely required private tool / approval API&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=21;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="1978.0" width="993.12" height="52.5" as="geometry" /></mxCell><mxCell id="optional-apim-body-0" value="Not deployed; NOT in the native Teams route; NOT required for a Foundry private endpoint." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="2017.0" width="1094.24" height="47.5" as="geometry" /></mxCell><mxCell id="optional-apim-body-1" value="Inbound private endpoint ≠ outbound VNet integration; neither grants private management-client access." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="2043.6" width="1252.32" height="47.5" as="geometry" /></mxCell><mxCell id="verified-foundation" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;fillColor=none;strokeColor=#0063B1;dashed=0;" parent="1" vertex="1"><mxGeometry x="1310" y="1965" width="1260" height="125" as="geometry" /></mxCell><mxCell id="verified-title-0" value="&lt;b&gt;VERIFIED DEPLOYED FOUNDATION ONLY&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="1978.0" width="476.64" height="55.0" as="geometry" /></mxCell><mxCell id="verified-body-0" value="Source Storage + officer-a-pending / officer-b-pending + VNet + Blob PE / DNS." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="2017.0" width="960.48" height="47.5" as="geometry" /></mxCell><mxCell id="verified-body-1" value="Public HTTPS network enabled; anonymous Blob and shared keys disabled. All other flows are targets." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="1330" y="2043.6" width="1215.84" height="47.5" as="geometry" /></mxCell><mxCell id="footer-0" value="No customer-hosted chat bridge or upload application. No PDF upload via Teams, agent, APIM or an application endpoint." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="30" y="2125.0" width="1522.4" height="50.0" as="geometry" /></mxCell><mxCell id="footer-1" value="Solid foundation boundaries indicate existing source/network assets only, not verified permissions. All isolation and lifecycle controls require end-to-end acceptance tests." style="fontFamily=Helvetica;fontColor=#000000;text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="30" y="2153.0" width="2226.4" height="50.0" as="geometry" /></mxCell><mxCell id="configured-container-role-a" value="Own container: Blob Data Contributor" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="390" y="677" width="380.64" height="40.0" as="geometry" /></mxCell><mxCell id="configured-account-role-a" value="ARM Reader at storage account" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="610" width="308.96" height="40.0" as="geometry" /></mxCell><mxCell id="configured-container-role-b" value="Own container: Blob Data Contributor" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="390" y="1257" width="380.64" height="40.0" as="geometry" /></mxCell><mxCell id="configured-account-role-b" value="ARM Reader at storage account" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="1190" width="308.96" height="40.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>