ce IP filter&lt;br&gt;Bot Service / Entra authorization&lt;br&gt;Not an all-private Teams path" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="348" y="840" width="294" height="91.2" /></mxCell><mxCell id="route-gate" value="" style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#C43E00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="1000" width="290" height="145" /></mxCell><mxCell id="route-gate-text" value="Native Foundry Activity route&lt;br&gt;BotServiceRbac authorization.&lt;br&gt;No Copilot Studio connectors&lt;br&gt;or Power Platform VNet." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="1018" width="260" height="91.2" /></mxCell><mxCell id="entra-zone" value="" style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="150" width="595" height="160" /></mxCell><mxCell id="entra-zone-title" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="726" y="162" width="563" height="32.7" /></mxCell><mxCell id="entra-symbol" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry as="geometry" x="733" y="214" width="55" height="55" /></mxCell><mxCell id="entra-text" value="Validated tenant + officer object ID&lt;br&gt;Server-owned officer-to-container mapping&lt;br&gt;No caller-selected partition or email-as-identity" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x=