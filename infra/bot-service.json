{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "botName": { "type": "string" },
    "displayName": { "type": "string" },
    "msaAppId": { "type": "string" },
    "tenantId": { "type": "string" },
    "endpoint": { "type": "string" },
    "botServiceSku": { "type": "string", "defaultValue": "F0" }
  },
  "resources": [
    {
      "type": "Microsoft.BotService/botServices",
      "apiVersion": "2022-09-15",
      "name": "[parameters('botName')]",
      "kind": "azurebot",
      "location": "global",
      "sku": { "name": "[parameters('botServiceSku')]" },
      "properties": {
        "displayName": "[parameters('displayName')]",
        "endpoint": "[parameters('endpoint')]",
        "msaAppId": "[parameters('msaAppId')]",
        "msaAppTenantId": "[parameters('tenantId')]",
        "msaAppType": "SingleTenant",
        "publicNetworkAccess": "Disabled"
      }
    },
    {
      "type": "Microsoft.BotService/botServices/channels",
      "apiVersion": "2021-03-01",
      "name": "[format('{0}/MsTeamsChannel', parameters('botName'))]",
      "location": "global",
      "properties": { "channelName": "MsTeamsChannel" },
      "dependsOn": [
        "[resourceId('Microsoft.BotService/botServices', parameters('botName'))]"
      ]
    }
  ],
  "outputs": {
    "botServiceArmId": {
      "type": "string",
      "value": "[resourceId('Microsoft.BotService/botServices', parameters('botName'))]"
    }
  }
}
